{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "macromix",
        "supportEmail": "satish.k3g@gmail.com",
        "authorizedRedirectUris": [
          "https://macro-streak-tracker.firebaseapp.com/__/auth/handler",
          "https://macromix.web.app/__/auth/handler",
          "http://localhost:5000",
          "http://localhost:8000"
        ]
      }
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs20"
  },
  "hosting": {
    "site": "macromix",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      ".venv/**",
      "test/**",
      "*.py",
      "*.md",
      "golden_benchmark.json",
      ".env*",
      "functions/**",
      "scratch/**",
      "skills-lock.json",
      "LICENSE"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(self), geolocation=()"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/authRegisterBegin",
        "function": "authRegisterBegin"
      },
      {
        "source": "/authRegisterComplete",
        "function": "authRegisterComplete"
      },
      {
        "source": "/authLoginBegin",
        "function": "authLoginBegin"
      },
      {
        "source": "/authLoginComplete",
        "function": "authLoginComplete"
      },
      {
        "source": "/getLeaderboard",
        "function": "getLeaderboard"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
