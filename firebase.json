{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "macromix",
        "supportEmail": "satish.k3g@gmail.com",
        "authorizedRedirectUris": [
          "https://macro-streak-tracker.firebaseapp.com/__/auth/handler",
          "https://macromix.web.app/__/auth/handler",
          "http://localhost:5000",
          "http://localhost:8000"
        ]
      }
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "macromix",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      ".venv/**",
      "test/**",
      "*.py",
      "golden_benchmark.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
